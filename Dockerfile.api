FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY db ./db
COPY cmd ./cmd
COPY internal ./internal
RUN go build -o /out/nexus-lens-api ./cmd/nexus-lens-api

FROM gcr.io/distroless/base-debian12
COPY --from=build /out/nexus-lens-api /nexus-lens-api
EXPOSE 5601
ENTRYPOINT ["/nexus-lens-api"]
