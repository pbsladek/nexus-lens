{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "pullPolicy"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "port", "image"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "image", "retention"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"]
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intervalSeconds",
            "scanRunDays",
            "cleanupExecutionDays",
            "verificationFindingDays",
            "trendSnapshotDays"
          ],
          "properties": {
            "intervalSeconds": { "type": "integer", "minimum": 0 },
            "scanRunDays": { "type": "integer", "minimum": 1 },
            "cleanupExecutionDays": { "type": "integer", "minimum": 1 },
            "verificationFindingDays": { "type": "integer", "minimum": 1 },
            "trendSnapshotDays": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "nexus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials"],
      "properties": {
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "usernameKey", "passwordKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destructiveExecution"],
      "properties": {
        "destructiveExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "deleteRPS", "maintenanceWindowUTC"],
          "properties": {
            "enabled": { "type": "boolean" },
            "deleteRPS": { "type": "number", "minimum": 0 },
            "maintenanceWindowUTC": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              }
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "hostKey",
        "portKey",
        "databaseKey",
        "usernameKey",
        "passwordKey",
        "sslMode"
      ],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "hostKey": { "type": "string", "minLength": 1 },
        "portKey": { "type": "string", "minLength": 1 },
        "databaseKey": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "initialAdmin"],
      "properties": {
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cookieSecure"],
          "properties": {
            "cookieSecure": { "type": "boolean" }
          }
        },
        "initialAdmin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "usernameKey", "passwordKey"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "minLength": 1 },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "labels",
            "queueAgeSeconds",
            "failedRuns24h",
            "highVerificationFindings",
            "cleanupRunningAgeSeconds",
            "cleanupFailedExecutions"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "queueAgeSeconds": { "type": "integer", "minimum": 1 },
            "failedRuns24h": { "type": "integer", "minimum": 1 },
            "highVerificationFindings": { "type": "integer", "minimum": 1 },
            "cleanupRunningAgeSeconds": { "type": "integer", "minimum": 1 },
            "cleanupFailedExecutions": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
