{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "pullPolicy"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "port", "image", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "image", "resources", "retention"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intervalSeconds",
            "scanRunDays",
            "cleanupExecutionDays",
            "verificationFindingDays",
            "trendSnapshotDays"
          ],
          "properties": {
            "intervalSeconds": { "type": "integer", "minimum": 0 },
            "scanRunDays": { "type": "integer", "minimum": 1 },
            "cleanupExecutionDays": { "type": "integer", "minimum": 1 },
            "verificationFindingDays": { "type": "integer", "minimum": 1 },
            "trendSnapshotDays": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "nexus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials"],
      "properties": {
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "usernameKey", "passwordKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destructiveExecution"],
      "properties": {
        "destructiveExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "deleteRPS", "maintenanceWindowUTC"],
          "properties": {
            "enabled": { "type": "boolean" },
            "deleteRPS": { "type": "number", "minimum": 0 },
            "maintenanceWindowUTC": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              }
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "hostKey",
        "portKey",
        "databaseKey",
        "usernameKey",
        "passwordKey",
        "sslMode"
      ],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "hostKey": { "type": "string", "minLength": 1 },
        "portKey": { "type": "string", "minLength": 1 },
        "databaseKey": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "sslMode": {
          "type": "string",
          "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "initialAdmin"],
      "properties": {
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cookieSecure"],
          "properties": {
            "cookieSecure": { "type": "boolean" }
          }
        },
        "initialAdmin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "usernameKey", "passwordKey"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "usernameKey": { "type": "string", "minLength": 1 },
            "passwordKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "minLength": 1 },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "labels",
            "queueAgeSeconds",
            "staleScheduleAgeSeconds",
            "failedRuns24h",
            "highVerificationFindings",
            "cleanupRunningAgeSeconds",
            "cleanupFailedExecutions"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "queueAgeSeconds": { "type": "integer", "minimum": 1 },
            "staleScheduleAgeSeconds": { "type": "integer", "minimum": 1 },
            "failedRuns24h": { "type": "integer", "minimum": 1 },
            "highVerificationFindings": { "type": "integer", "minimum": 1 },
            "cleanupRunningAgeSeconds": { "type": "integer", "minimum": 1 },
            "cleanupFailedExecutions": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    }
  }
}
